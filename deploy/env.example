# Copy to deploy/.env (install.sh does this for you and fills in secrets).

# Public hostname pointing at this VPS (A record). Used for HTTPS and TURN.
DOMAIN=ndiho.example.com
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=admin@example.com
# The VPS's public IPv4 address (used by the TURN server).
PUBLIC_IP=203.0.113.10
# IPv4 address of the main network interface (`ip -4 route get 1.1.1.1` → src).
# Same as PUBLIC_IP on most VPS plans; differs when the provider uses NAT.
RELAY_IP=203.0.113.10

# Secrets: generate with `openssl rand -hex 32` (hex only: coturn reads TURN_SECRET via a shell).
POSTGRES_PASSWORD=change-me
TURN_SECRET=change-me

# TURN relay port range (must match the firewall rule).
TURN_MIN_PORT=49160
TURN_MAX_PORT=49999

# Troubleshooting only: "relay" forces all media through TURN.
NDIHO_ICE_TRANSPORT_POLICY=all

# Testing only: "local_certs" makes Caddy use its own CA instead of Let's Encrypt.
CADDY_EXTRA_GLOBAL=
